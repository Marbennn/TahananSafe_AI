# TahananSafe AI - Environment variables (copy to .env and edit)

# Model paths (inference loads base model + adapter from MODEL_PATH)
MODEL_PATH=./models/fine_tuned
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# API
PORT=8000
HOST=0.0.0.0

# Hugging Face (optional; needed for gated/private models or to avoid rate limits)
# Never commit real tokens to git.
HF_TOKEN=your_huggingface_token_here

# Training (optional; config.yaml is the main source; these can override)
# USE_4BIT=false is typical for 4GB GPU training; set true for inference if using 4-bit base
USE_4BIT=false
USE_8BIT=false

# Inference performance
ENABLE_ANALYZE_CACHE=true
ANALYZE_CACHE_SIZE=512

# Step 5: model-first inference controls
MODEL_FIRST_MODE=true
MODEL_RISK_BLEND_NUMERIC=0.9
MODEL_RISK_BLEND_LEVEL=0.75
MODEL_RETRIEVAL_OVERRIDE_SIMILARITY=0.55
# false = retrieval can influence type/confidence but not risk percentage
ENABLE_RETRIEVAL_RISK_BLEND=false
# Recommended for stable risk outputs:
# false = risk derived from evidence/context, not model-generated risk number
USE_MODEL_RISK_PERCENTAGE=false
ENABLE_CONFIDENCE_CALIBRATION=true
CONFIDENCE_CALIBRATION_PATH=./models/confidence_calibrator.json
CONFIDENCE_CALIBRATION_MIN_EXAMPLES=500
CONFIDENCE_CALIBRATION_REQUIRE_MODEL=true
CONFIDENCE_CALIBRATION_BLEND=0.6
CONFIDENCE_CALIBRATION_MAX_DELTA=12.0

# Retrieval-augmented decision support (CSV-first)
ENABLE_CASE_RETRIEVAL=true
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.12
RETRIEVAL_OVERRIDE_MIN_SIMILARITY=0.40
RETRIEVAL_QUERY_CACHE_SIZE=512
MAIN_DATASET_PATH=./datasets/Main_Dataset.csv
NEGATIVE_DATASET_PATH=./datasets/Negative_Dataset.csv
